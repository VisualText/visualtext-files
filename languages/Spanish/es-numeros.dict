# Numerales con su valor numérico
#   s=numero   en todas las entradas: el tokenizador envuelve la forma en un
#              nodo _numero (igual que s=number en en-numbers.dict da _number)
#   valor=     el valor que nombra la palabra
#   ord=1      un ordinal (primero, segundo...) y no un cardinal
#   grupo=1    un sustantivo colectivo de cantidad (docena, centenar, millar)
#   raiz=      la forma canónica, en una variante: femenino (una, doscientas,
#              primera), apócope (un, primer, veintiún), forma sin tilde
#              (dieciseis, veintidos), variante (sétimo, decimoprimero) o
#              plural (millones, docenas)
#   gen=m|f    género, en las formas que lo marcan
#   num=p      forma plural (cientos, miles, millones, docenas)
#   ambig=1    la forma es también una palabra corriente: un/una/uno
#              (artículo y pronombre), segundo (unidad de tiempo), cuarto
#              (habitación), par, quincena, cuarentena, gruesa, décimo (de
#              lotería), sexto, nono, quinta (casa de campo), octava (música)
#              y novena (rezo)
# Escala larga: billón = 10^12, trillón = 10^18 (no 10^9 y 10^12 como en el
# inglés billion / trillion); millardo = 10^9.  Los compuestos de varias
# palabras (treinta y uno, dos mil) no se listan, como en en-numbers.dict.

cero s=numero valor=0 pos=s
uno s=numero valor=1 gen=m ambig=1 pos=pron
uno pos=v
un s=numero valor=1 raiz=uno gen=m ambig=1 pos=pron
una s=numero valor=1 raiz=uno gen=f ambig=1 pos=pron
una pos=v

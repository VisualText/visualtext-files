    especialización: titulo=["especialidad médica",especialización]
    maestría: titulo=["diploma de estudios avanzados",maestría,"maestría en administración de empresas","maestría en ciencias","maestría en derecho","maestría en educación","maestría en finanzas","maestría en salud pública",magíster,máster,"máster de acceso a la abogacía","máster en formación del profesorado","master of arts","master of laws","master of philosophy","master of science"]
    doctorado: titulo=["doctor of medicine","doctor of philosophy",doctorado,"doctorado en ciencias","doctorado en derecho","doctorado en educación","doctorado en filosofía","doctorado honoris causa","juris doctor"]
    posdoctorado: palabra=[posdoctorado,postdoctorado,posdoc,postdoc,posdoctoral,postdoctoral]
    posgrado: palabra=[posgrado,postgrado,posgrados,postgrados], incluye=[especialización,maestría,doctorado]

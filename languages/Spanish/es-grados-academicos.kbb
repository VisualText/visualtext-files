# Títulos y grados académicos en español, con sus niveles, áreas y abreviaturas.
# Búsqueda directa:  nombre -> nivel, área  (concepto "grados titulo licenciatura" -> nivel=grado)
# Búsqueda inversa:  abreviatura -> nombre  (concepto "grados abrev mba" -> titulo="maestría en administración de empresas")
# Búsqueda por nivel: nivel -> sus palabras genéricas y sus títulos
# A diferencia de en-degrees.kbb, la clave es el nombre desarrollado: los
# títulos en español se nombran, casi nunca se abrevian.
#   nivel=        técnico | grado | especialización | maestría | doctorado
#   area=         la materia (nombre canónico de es-areas-de-estudio.kbb)
#   abrev=        la abreviatura canónica    sinonimo=  abreviaturas variantes
#   variante=     nombres alternativos del título
#   poseedor=     los sustantivos de quien lo posee (masculino, femenino...)
#   es=1  latam=1  extranjero=1  antiguo=1  profesional=1  honorifico=1
#                 como en es-grados-academicos.dict
#   tratamiento=1 la abreviatura figura también en es-tratamientos.dict
# En la rama abrev, una abreviatura de varios títulos lleva ambig=1 y
# titulo=[...] con todos ellos.
# En la rama nivel, palabra= son las palabras genéricas, titulo= los títulos
# de ese nivel e incluye= los niveles que abarca un término genérico (posgrado).
# Todas las formas nombradas aquí están etiquetadas en es-grados-academicos.dict.
# Generado por python/gen_degrees_es.py; no editar a mano.
grados
  titulo
    arquitectura: nivel=grado, area=arquitectura, abrev=arq, variante="título de arquitecto", poseedor=[arquitecto,arquitecta], profesional=1
    arquitectura técnica: nivel=grado, area=arquitectura, poseedor=["arquitecto técnico","arquitecta técnica",aparejador,aparejadora], es=1, antiguo=1, profesional=1
    bachelor of arts: nivel=grado, area=humanidades, abrev=ba, extranjero=1
    bachelor of business administration: nivel=grado, area="administración de empresas", abrev=bba, extranjero=1
    bachelor of science: nivel=grado, area="ciencias naturales", abrev=bsc, extranjero=1
    bachillerato universitario: nivel=grado, abrev=bach, variante=["grado de bachiller","grado académico de bachiller"], poseedor=bachiller, latam=1
    diploma de estudios avanzados: nivel=maestría, abrev=dea, variante="suficiencia investigadora", es=1, antiguo=1
    diplomatura: nivel=grado, poseedor=[diplomado,diplomada], es=1, antiguo=1
    doctor of medicine: nivel=doctorado, area=medicina, abrev=md, extranjero=1, profesional=1
    doctor of philosophy: nivel=doctorado, abrev=phd, sinonimo=dphil, variante="philosophiae doctor", extranjero=1
    doctorado: nivel=doctorado, variante=["título de doctor","grado de doctor"], poseedor=[doctor,doctora]
    doctorado en ciencias: nivel=doctorado, area="ciencias naturales", poseedor=["doctor en ciencias","doctora en ciencias"]
    doctorado en derecho: nivel=doctorado, area=derecho, poseedor=["doctor en derecho","doctora en derecho"]
    doctorado en educación: nivel=doctorado, area=educación, poseedor=["doctor en educación","doctora en educación"]
    doctorado en filosofía: nivel=doctorado, area=filosofía, poseedor=["doctor en filosofía","doctora en filosofía"]
    doctorado honoris causa: nivel=doctorado, variante=["doctor honoris causa","doctora honoris causa","honoris causa"], honorifico=1
    especialidad médica: nivel=especialización, area=medicina, variante="residencia médica", poseedor=["médico especialista","médica especialista"], profesional=1
    especialización: nivel=especialización, abrev=esp, variante=[especialidad,"título de especialista","diploma de especialización"], poseedor=especialista
    grado: nivel=grado, variante=["título de grado","grado universitario"], poseedor=[graduado,graduada,"graduado universitario","graduada universitaria"], es=1

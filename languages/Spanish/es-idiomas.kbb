# Nombres de idiomas en español.
# Cada idioma canónico lleva sus códigos ISO 639-1 (iso2=) e ISO 639-2/B (iso3=),
# los mismos de en-languages.kbb, y sus variantes en sinonimo=.  Cada variante es
# también un concepto propio con sin=1 y raiz= (el nombre canónico).
# Generado por python/gen_geo_es.py: no editar a mano.
idiomas
  abjasio: iso2=ab, iso3=abk, sinonimo=abjaso
  abjaso: sin=1, raiz=abjasio, iso2=ab, iso3=abk
  afar: iso2=aa, iso3=aar
  afrikaans: sin=1, raiz=afrikáans, iso2=af, iso3=afr
  afrikáans: iso2=af, iso3=afr, sinonimo=afrikaans
  aimara: iso2=ay, iso3=aym, sinonimo=[aimará,aymara]
  aimará: sin=1, raiz=aimara, iso2=ay, iso3=aym
  akan: iso2=ak, iso3=aka
  albanés: iso2=sq, iso3=alb
  alemán: iso2=de, iso3=ger
  amhárico: iso2=am, iso3=amh
  antiguo eslavo eclesiástico: sin=1, raiz="eslavo eclesiástico", iso2=cu, iso3=chu
  aragonés: iso2=an, iso3=arg
  armenio: iso2=hy, iso3=arm
  asamés: iso2=as, iso3=asm

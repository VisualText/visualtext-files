# Formas de tratamento: prefixos e sufixos de nomes de pessoas
#   sufixo= / prefixo=  o que a forma indica, por extenso
#   tipo=               geração | grau | cortesia | nobreza | profissional |
#                       religioso | militar | civil
#   gen=m|f             género do título
#   ambig=1             também é palavra comum ou entrada de outro dicionário
#                       da biblioteca, por isso só é tratamento junto de um nome
# Toda forma aqui citada é etiquetada por pt-tratamentos.dict.

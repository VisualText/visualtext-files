# Áreas de estudo em português, ligadas às grandes áreas do CNPq / CAPES.
# Consulta direta:  área -> grande área   (conceito "areas area biologia" -> grandearea="ciências biológicas")
# Grandes áreas:    grande área -> as suas áreas
# A árvore percorre-se nos dois sentidos: pai= aponta para cima, filho= para baixo.
#   grandearea=   ciências exatas e da terra | ciências biológicas |
#                 engenharias | ciências da saúde | ciências agrárias |
#                 ciências sociais aplicadas | ciências humanas |
#                 linguística, letras e artes | multidisciplinar
#   pai=          a área mais ampla de que esta faz parte
#   filho=        os filhos imediatos desta área
#   sinonimo=     nomes alternativos       adjetivo=  formas adjetivas
#   escolar=1     disciplina escolar comum
#   idioma=1      o nome é também um idioma e uma nacionalidade
#   br=1          só no Brasil             pt=1  só em Portugal
# Os nomes de área daqui são o vocabulário de area= em
# pt-graus-academicos.dict, para que um grau se ligue à sua área por esse
# atributo.
# Toda forma aqui citada é etiquetada por pt-areas-de-estudo.dict.
areas
  area
    administração: grandearea="ciências sociais aplicadas", sinonimo=["administração de empresas",gestão,"gestão de empresas",negócios], adjetivo=[administrativo,administrativa], filho=[contabilidade,finanças,marketing,empreendedorismo,"recursos humanos","comércio exterior",logística,"gestão imobiliária",hotelaria,"ciências atuariais",secretariado]
    administração pública: grandearea="ciências sociais aplicadas", sinonimo="gestão pública", filho="políticas públicas"
    agronomia: grandearea="ciências agrárias", pai="ciências agrárias", sinonimo=["engenharia agronômica","engenharia agronómica"], adjetivo=[agronômico,agronômica,agronómico,agronómica]
    alemão: grandearea="linguística, letras e artes", pai="línguas estrangeiras", sinonimo="língua alemã", escolar=1, idioma=1
    anatomia: grandearea="ciências biológicas", pai=biologia, adjetivo=[anatômico,anatômica,anatómico,anatómica]
    anestesiologia: grandearea="ciências da saúde", pai=medicina
    antropologia: grandearea="ciências humanas", adjetivo=[antropológico,antropológica], filho=arqueologia
    aprendizado de máquina: grandearea="ciências exatas e da terra", pai="inteligência artificial", sinonimo=["aprendizagem de máquina","aprendizagem automática","machine learning"]
    aritmética: grandearea="ciências exatas e da terra", pai=matemática, escolar=1
    arqueologia: grandearea="ciências humanas", pai=antropologia, adjetivo=[arqueológico,arqueológica]
    arquitetura: grandearea="ciências sociais aplicadas", sinonimo=["arquitetura e urbanismo",arquitectura], adjetivo=[arquitetônico,arquitetônica,arquitetónico,arquitetónica], filho=paisagismo
    arquivologia: grandearea="ciências sociais aplicadas", pai="ciência da informação", sinonimo=arquivística
    arte: grandearea="linguística, letras e artes", sinonimo=[artes,"artes visuais"], adjetivo=[artístico,artística], filho=["educação artística","educação visual",belas-artes,desenho,pintura,escultura,fotografia,cerâmica,gravura,"artes aplicadas"], escolar=1
    artes aplicadas: grandearea="linguística, letras e artes", pai=arte
    artes cênicas: grandearea="linguística, letras e artes", sinonimo=["artes cénicas","artes do espetáculo","artes performativas"], adjetivo=[cênico,cênica], filho=[teatro,dança]
    artes liberais: grandearea=multidisciplinar, sinonimo="estudos liberais"
    astrofísica: grandearea="ciências exatas e da terra", pai=física
    astronomia: grandearea="ciências exatas e da terra", pai=ciências, adjetivo=[astronômico,astronômica,astronómico,astronómica], filho=[cosmologia,"ciências planetárias"]
    audiologia: grandearea="ciências da saúde", pai=fonoaudiologia
    bacteriologia: grandearea="ciências biológicas", pai=biologia
    belas-artes: grandearea="linguística, letras e artes", pai=arte, sinonimo="belas artes"
    biblioteconomia: grandearea="ciências sociais aplicadas", pai="ciência da informação", sinonimo="biblioteconomia e documentação"
    biofísica: grandearea="ciências biológicas", pai=biologia, adjetivo=[biofísico,biofísica]
    biologia: grandearea="ciências biológicas", pai=ciências, sinonimo=[bio,"ciências biológicas","ciências da vida"], adjetivo=[biológico,biológica], filho=[botânica,zoologia,microbiologia,"biologia molecular","biologia celular",genética,bioquímica,biofísica,ecologia,"biologia marinha",neurociência,fisiologia,anatomia,imunologia,virologia,bacteriologia,micologia,parasitologia,entomologia,ornitologia,"biologia evolutiva",farmacologia,biotecnologia], escolar=1
    biologia celular: grandearea="ciências biológicas", pai=biologia, sinonimo=citologia
    biologia evolutiva: grandearea="ciências biológicas", pai=biologia, sinonimo="biologia evolucionária"
    biologia marinha: grandearea="ciências biológicas", pai=biologia
    biologia molecular: grandearea="ciências biológicas", pai=biologia
    biomedicina: grandearea="ciências da saúde", br=1
    bioquímica: grandearea="ciências biológicas", pai=biologia, adjetivo=[bioquímico,bioquímica]
    biotecnologia: grandearea=multidisciplinar, pai=biologia
    botânica: grandearea="ciências biológicas", pai=biologia, sinonimo="biologia vegetal", adjetivo=[botânico,botânica]
    cardiologia: grandearea="ciências da saúde", pai=medicina
    cerâmica: grandearea="linguística, letras e artes", pai=arte
    chinês: grandearea="linguística, letras e artes", pai="línguas estrangeiras", sinonimo=mandarim, idioma=1
    cidadania e desenvolvimento: grandearea="ciências humanas", pai="estudos sociais", escolar=1, pt=1
    cinema: grandearea="linguística, letras e artes", sinonimo=["cinema e audiovisual",audiovisual,"estudos de cinema"], adjetivo=[cinematográfico,cinematográfica]
    cirurgia: grandearea="ciências da saúde", pai=medicina, adjetivo=[cirúrgico,cirúrgica]
    ciência cognitiva: grandearea="ciências humanas", pai=psicologia, sinonimo="ciências cognitivas", adjetivo=[cognitivo,cognitiva]
    ciência da computação: grandearea="ciências exatas e da terra", sinonimo=[computação,"ciências da computação",informática], adjetivo=computacional, filho=["engenharia de software","inteligência artificial","ciência de dados","segurança da informação","tecnologia da informação","sistemas de informação","computação gráfica","interação humano-computador"]
    ciência da informação: grandearea="ciências sociais aplicadas", filho=[biblioteconomia,arquivologia,museologia]
    ciência de dados: grandearea="ciências exatas e da terra", pai="ciência da computação"
    ciência do solo: grandearea="ciências agrárias", pai="ciências agrárias", sinonimo=pedologia
    ciência e tecnologia de alimentos: grandearea="ciências agrárias", pai="ciências agrárias", sinonimo=["ciência dos alimentos","tecnologia de alimentos","engenharia de alimentos"]
    ciência política: grandearea="ciências humanas", sinonimo=["ciências políticas",política], adjetivo=[político,política]
    ciências: grandearea="ciências exatas e da terra", sinonimo=[ciência,"ciências naturais"], adjetivo=[científico,científica], filho=[química,física,astronomia,geociências,biologia], escolar=1
    ciências agrárias: grandearea="ciências agrárias", sinonimo=agricultura, adjetivo=[agrário,agrária,agrícola], filho=[agronomia,horticultura,zootecnia,"engenharia florestal","ciência e tecnologia de alimentos","engenharia de pesca","engenharia agrícola","ciência do solo"]
    ciências ambientais: grandearea=multidisciplinar, sinonimo=["ciência ambiental","estudos ambientais","gestão ambiental"], adjetivo=ambiental, filho=[sustentabilidade,"educação ambiental"]
    ciências aplicadas: grandearea=multidisciplinar
    ciências atuariais: grandearea="ciências sociais aplicadas", pai=administração, sinonimo=atuária, adjetivo=atuarial
    ciências da religião: grandearea="ciências humanas", pai=humanidades, sinonimo=["ciência da religião","estudos religiosos"], filho=[teologia,"ensino religioso"]
    ciências do esporte: grandearea="ciências da saúde", sinonimo=["ciências do desporto","ciência do esporte"]
    ciências planetárias: grandearea="ciências exatas e da terra", pai=astronomia, sinonimo=planetologia

# Nacionalidades (gentílicos) em português, relacionadas a seus países.
# Consulta direta:   nacionalidade -> país  (conceito "nacionalidades nacionalidade francês" -> pais=frança)
# Consulta inversa:  país -> nacionalidade  (conceito "nacionalidades pais frança" -> nacionalidade=francês)
# Cada nacionalidade é nomeada pelo masculino singular e traz fem= (feminino
# singular), plural= (masculino plural), fempl= (feminino plural), gen=m ou
# gen=c (comum de dois) e os códigos ISO 3166-1 do país.  Os nomes de país são
# os de pt-paises.dict / pt-paises.kbb, de modo que as duas bases se juntam.
# Uma forma que designa mais de um país leva ambig=1 e suas demais leituras
# ficam abaixo dela como <nome>1, <nome>2, ... (mesma convenção de en-nationalities.kbb).
# Entradas de país com sin=1 são variantes (holanda, eua, birmânia, irão ...)
# com raiz= apontando para o nome canônico.
# Gerado por python/gen_geo_pt.py; não editar à mão.
nacionalidades
  nacionalidade
    afegão: pais=afeganistão, iso2=af, iso3=afg, gen=m, fem=afegã, plural=afegãos, fempl=afegãs
    alandês: pais="ilhas åland", iso2=ax, iso3=ala, gen=m, fem=alandesa, plural=alandeses, fempl=alandesas
    albanês: pais=albânia, iso2=al, iso3=alb, gen=m, fem=albanesa, plural=albaneses, fempl=albanesas
    alemão: pais=alemanha, iso2=de, iso3=deu, gen=m, fem=alemã, plural=alemães, fempl=alemãs
    americano: pais="estados unidos", iso2=us, iso3=usa, gen=m, fem=americana, plural=americanos, fempl=americanas, sinonimo=["norte-americano",estadunidense,"estado-unidense"]
    andorrano: pais=andorra, iso2=ad, iso3=and, gen=m, fem=andorrana, plural=andorranos, fempl=andorranas
    angolano: pais=angola, iso2=ao, iso3=ago, gen=m, fem=angolana, plural=angolanos, fempl=angolanas
    anguilano: pais=anguila, iso2=ai, iso3=aia, gen=m, fem=anguilana, plural=anguilanos, fempl=anguilanas
    antiguano: pais="antígua e barbuda", iso2=ag, iso3=atg, gen=m, fem=antiguana, plural=antiguanos, fempl=antiguanas, sinonimo=barbudano

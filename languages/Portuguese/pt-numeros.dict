# Numeros em Portugues
# Numerais por extenso com o seu valor numérico.
#   numero=1    toda entrada
#   num=        o valor numérico (nesta lista num= é o valor, não o número
#               gramatical s/p de pt-full.dict; pt-numeros.kbb chama-lhe valor=)
#   cardinal=1  numeral cardinal (um, dois, cem)
#   ordinal=1   numeral ordinal (primeiro, segundo)
#   coletivo=1  numeral coletivo (par, dezena, dúzia, centena, milhar)
#   potencia=n  nos nomes em -ilião (escala longa, uso europeu), a potência de
#               um milhão: bilião = 10^12, trilião = 10^18
#   gen=f       forma feminina (uma, duas, duzentas, primeira)
#   plural=1    forma plural (milhões, bilhões, dezenas, milhares)
#   coloquial=1 uso coloquial ("meia" por seis ao ditar números, no Brasil)
#   ambig=1     também é palavra comum ou entrada de outro dicionário da
#               biblioteca (segunda, quinta, par, meia)
# Formas brasileiras e europeias convivem: dezesseis / dezasseis,
# dezessete / dezassete, dezenove / dezanove, quatorze / catorze.  Os nomes
# em -ilhão (bilhão = 10^9, escala curta) são brasileiros; os nomes em -ilião
# são europeus e seguem a escala longa (ver potencia=).  Atenção: o num= das
# linhas bilião..sextilião segue a escala curta e não coincide com potencia=.
zero num=0 cardinal=1 numero=1 pos=s
um num=1 cardinal=1 numero=1 pos=pron
um pos=s
dois num=2 cardinal=1 numero=1 pos=s
três num=3 cardinal=1 numero=1 pos=s
quatro num=4 cardinal=1 numero=1 pos=num
cinco num=5 cardinal=1 numero=1 pos=v
seis num=6 cardinal=1 numero=1 pos=s
sete num=7 cardinal=1 numero=1 pos=num
oito num=8 cardinal=1 numero=1 pos=s
nove num=9 cardinal=1 numero=1 pos=s
dez num=10 cardinal=1 numero=1 pos=s
onze num=11 cardinal=1 numero=1 pos=s

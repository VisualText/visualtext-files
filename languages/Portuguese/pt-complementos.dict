# Complementos de endereço (designadores secundários)
#   complemento=1  toda entrada
#   abrev=         na forma por extenso, a abreviatura principal
#   completo=      na abreviatura, a forma por extenso
#   raiz=          numa grafia sem acento (terreo, edificio), a forma canónica
#   pt=1           uso de Portugal (rés-do-chão, esquerdo, direito)
#   ambig=1        a forma é também entrada de outro dicionário da biblioteca
#                  (bl, lt, st e res em pt-logradouro.dict, quarto em
#                  pt-numeros.dict, ap em pt-estados.dict)
# Quase toda forma por extenso é também uma palavra comum (casa, sala, loja,
# frente), por isso a leitura como complemento precisa de contexto: vir depois
# do número do logradouro ou antes de um número ("apto 302", "bloco b").
# As abreviaturas estão sem os pontos: o tokenizador separa os pontos.
apartamento complemento=1 abrev=apto pos=s
apto complemento=1 completo=apartamento pos=adj
apto pos=v
ap complemento=1 completo=apartamento ambig=1 pos=s
apt complemento=1 completo=apartamento pos=s
bloco complemento=1 abrev=bl ambig=1 pos=s
bl complemento=1 completo=bloco ambig=1 pos=s
blc complemento=1 completo=bloco pos=s

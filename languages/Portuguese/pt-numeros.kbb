# Numerais em português com os seus valores numéricos.
# Consulta direta:   palavra -> valor  (ex.: conceito "doze" -> valor=12)
# Consulta inversa:  valor -> palavra  (ex.: numeroporvalor "12" -> nome=doze)
# O mesmo par existe para os ordinais: "décimo segundo" -> valor=12, e
# ordinalporvalor "12" -> nome="décimo segundo".
# Os índices inversos só cobrem as palavras com valor das listas diretas.
# coletivos guarda os numerais coletivos (par, dezena, dúzia, centena, milhar).
#   valor=      o valor numérico (em pt-numeros.dict este valor está em num=;
#               aqui chama-se valor= porque num= é o número gramatical s/p em
#               pt-full.kbb)
#   sinonimo=   outra forma do mesmo numeral: a variante europeia (dezasseis)
#               ou brasileira (quatorze), ou uma forma rara
#   feminino=   a forma feminina          plural=  a forma plural
#   escala=     curta (bilhão = 10^9, Brasil) | longa (bilião = 10^12, Portugal)
#   potencia=n  nos nomes em -ilião (escala longa), a potência de um milhão;
#               nos ordinais em -ilionésimo, o n de pt-numeros.dict
#   br=1        forma brasileira          pt=1  forma europeia
#   europeu=    na consulta inversa, o nome europeu do mesmo valor quando
#               difere (10^9 = "mil milhões", 10^12 = bilião)
# Os nomes em -ilião acima de sextilião não têm valor=, só potencia=.
# Atenção: pt-numeros.dict dá a bilião..sextilião um num= da escala curta
# (bilião num=10^9); aqui valor= segue a escala longa, coerente com
# potencia=.  Os ordinais em -ilionésimo seguem o num= do dicionário (escala
# curta, uso brasileiro).
# Toda forma aqui citada é etiquetada por pt-numeros.dict.
numeros
  palavras
    zero: valor=0
    um: valor=1, feminino=uma
    dois: valor=2, feminino=duas
    três: valor=3
    quatro: valor=4
    cinco: valor=5
    seis: valor=6, sinonimo=meia
    sete: valor=7
    oito: valor=8
    nove: valor=9
    dez: valor=10
    onze: valor=11
    doze: valor=12
    treze: valor=13
    catorze: valor=14, sinonimo=quatorze
    quinze: valor=15
    dezesseis: valor=16, sinonimo=dezasseis
    dezessete: valor=17, sinonimo=dezassete
    dezoito: valor=18
    dezenove: valor=19, sinonimo=dezanove
    vinte: valor=20
    trinta: valor=30
    quarenta: valor=40
    cinquenta: valor=50
    sessenta: valor=60
    setenta: valor=70
    oitenta: valor=80
    noventa: valor=90
    cem: valor=100, sinonimo=cento
    duzentos: valor=200, feminino=duzentas
    trezentos: valor=300, feminino=trezentas
    quatrocentos: valor=400, feminino=quatrocentas
    quinhentos: valor=500, feminino=quinhentas
    seiscentos: valor=600, feminino=seiscentas
    setecentos: valor=700, feminino=setecentas
    oitocentos: valor=800, feminino=oitocentas
    novecentos: valor=900, feminino=novecentas
    mil: valor=1000
    milhão: valor=1000000, plural=milhões
    bilhão: valor=1000000000, escala=curta, plural=bilhões, br=1
    trilhão: valor=1000000000000, escala=curta, plural=trilhões, br=1
    quatrilhão: valor=1000000000000000, escala=curta, br=1
    quintilhão: valor=1000000000000000000, escala=curta, br=1
    sextilhão: valor=1000000000000000000000, escala=curta, br=1
    bilião: valor=1000000000000, potencia=2, escala=longa, pt=1
    trilião: valor=1000000000000000000, potencia=3, escala=longa, pt=1
    quatrilião: valor=1000000000000000000000000, potencia=4, escala=longa, pt=1
    quintilião: valor=1000000000000000000000000000000, potencia=5, escala=longa, pt=1
    sextilião: valor=1000000000000000000000000000000000000, potencia=6, escala=longa, pt=1
    septilião: potencia=7, escala=longa, pt=1
    octilião: potencia=8, escala=longa, pt=1
    nonilião: potencia=9, escala=longa, pt=1
    decilião: potencia=10, escala=longa, pt=1
    undecilião: potencia=11, escala=longa, pt=1
    duodecilião: potencia=12, escala=longa, pt=1
    tredecilião: potencia=13, escala=longa, pt=1
    quatuordecilião: potencia=14, escala=longa, pt=1
    quindecilião: potencia=15, escala=longa, pt=1
    sexdecilião: potencia=16, escala=longa, pt=1
    septendecilião: potencia=17, escala=longa, pt=1
    octodecilião: potencia=18, escala=longa, pt=1
    novendecilião: potencia=19, escala=longa, pt=1
    vigintilião: potencia=20, escala=longa, pt=1
    trigintilião: potencia=30, escala=longa, pt=1
    quadragintilião: potencia=40, escala=longa, pt=1
    quinquagintilião: potencia=50, escala=longa, pt=1
    sexagintilião: potencia=60, escala=longa, pt=1
    septuagintilião: potencia=70, escala=longa, pt=1
    octogintilião: potencia=80, escala=longa, pt=1
    nonagintilião: potencia=90, escala=longa, pt=1
    centilião: potencia=100, escala=longa, pt=1
    ducentilião: potencia=200, escala=longa, pt=1
    trecentilião: potencia=300, escala=longa, pt=1
    quadringentilião: potencia=400, escala=longa, pt=1
    quingentilião: potencia=500, escala=longa, pt=1
    sescentilião: potencia=600, escala=longa, pt=1
    septingentilião: potencia=700, escala=longa, pt=1
    octingentilião: potencia=800, escala=longa, pt=1
    nongentilião: potencia=900, escala=longa, pt=1
    miliatilião: potencia=1000, escala=longa, pt=1
    miliamiliatilião: valor=1000000, potencia=1, escala=longa, pt=1
